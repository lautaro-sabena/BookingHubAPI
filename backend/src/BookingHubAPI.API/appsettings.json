{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "BookingHubAPI",
    "Audience": "BookingHubAPI",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "ForwardedHeaders": {
    "TrustAllProxies": false,
    "ForwardLimit": 1
  },
  "Auth": {
    "Cookie": {
      "Name": "bookinghub_session",
      "Secure": true
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "EndpointWhitelist": ["get:/health"],
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "5m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/auth/register",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/reservations",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/api/reservations",
        "Period": "1m",
        "Limit": 30
      }
    ]
  }
}